<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code/SkateMotion/Core compiled as a plain .NET library. It proves Core has no s&box dependency
       and lets the tests run in seconds without the engine. Not shipped. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SkateMotion.Core</AssemblyName>
    <RootNamespace>SkateMotion</RootNamespace>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Code\SkateMotion\Assembly.cs" />
    <Compile Include="..\Code\SkateMotion\Core\**\*.cs" />
    <!-- The plain types Core's network sharing (Core/Networking) packs: a board's state and its rider's controls. -->
    <Compile Include="..\Code\SkateMotion\Api\SkateState.cs" />
    <Compile Include="..\Code\SkateMotion\Api\SkateInput.cs" />
    <Compile Include="..\Code\SkateMotion\Api\SkateGrind.cs" />
    <Compile Include="..\Code\SkateMotion\Api\SkateBalanceMode.cs" />
    <Compile Include="..\Code\SkateMotion\Api\SkateAirGrab.cs" />
    <Compile Include="..\Code\SkateMotion\Api\SkatePushFeet.cs" />
    <Compile Include="TestAccess.cs" />
  </ItemGroup>

</Project>
